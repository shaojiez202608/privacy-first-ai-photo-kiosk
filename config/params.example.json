{
  "deploy": {
    "stack_name": "proto-kiosk-sandbox",
    "resource_prefix": "proto-kiosk",
    "region": "us-east-1",
    "removal_policy": "destroy",
    "log_retention_days": 7,
    "image_bucket_versioning": true,
    "lambda_memory_mb": 1024,
    "processor_timeout_s": 120,
    "api_throttle_rate": 5,
    "api_throttle_burst": 10,
    "cors_extra_origins": [],
    "tags": {
      "Project": "photo-kiosk",
      "Purpose": "prototype",
      "Teardown": "after-test"
    }
  },
  "frontend": {
    "enabled": true,
    "geo_allowlist": []
  },
  "session": {
    "kiosk_id": "kiosk-demo-01",
    "notice_version": "2026-10-v1",
    "retention_seconds": 300,
    "share_link_ttl_seconds": 120,
    "ttl_grace_seconds": 3600,
    "max_upload_bytes": 3000000,
    "max_side": 1024,
    "min_side": 64,
    "max_aspect": 2.5,
    "max_pixels": 16000000,
    "operator_contact": "Ask the kiosk operator, or write to privacy@example.com"
  },
  "image_model": {
    "provider": "transform",
    "model_id": "",
    "family": "",
    "strength": 0.6,
    "allow_cross_region_inference": false
  },
  "moderation": {
    "provider": "guardrails",
    "filter_strength": "HIGH",
    "allow_unmoderated": false
  },
  "logging": {
    "data_identifiers": ["Address", "EmailAddress", "IpAddress", "LatLong", "Name"]
  }
}
